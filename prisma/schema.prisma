// ==========================================================================
// ZICHRI SCHOOL RESULT MANAGEMENT SYSTEM — CORE DATA MODEL
// ==========================================================================
// Provider is SQLite for zero-config local development. Swap "provider" to
// "postgresql" and set DATABASE_URL to a real Postgres URL for production —
// no other schema changes are required, all types used here are portable.
// ==========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Set to "postgresql" — this project runs on a real Postgres database
  // (e.g. Neon) in production. SQLite is kept here only as a comment for
  // reference, since it doesn't support this schema's enum types at all
  // and switching back would break the database entirely.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------------------------
// ENUMS
// --------------------------------------------------------------------------

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum AccountStatus {
  PENDING
  VERIFIED
  REJECTED
  REMOVED
}

enum SpreadsheetStatus {
  DRAFT
  SAVED
  LOCKED
}

enum Sex {
  MALE
  FEMALE
}

enum DeliveryChannel {
  EMAIL
  DASHBOARD
  PDF_DOWNLOAD
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

// --------------------------------------------------------------------------
// CORE IDENTITY / AUTH
// --------------------------------------------------------------------------

// One row per login-capable identity, regardless of role. Keeping a single
// `User` table means auth/session code is written once and role tables
// (Admin/Teacher/Student) hold only role-specific profile data. This is the
// standard "table-per-type with shared identity" pattern and is what lets
// us enforce "username is globally unique" and "one password hash format"
// in one place.
model User {
  id            String        @id @default(cuid())
  username      String        @unique
  passwordHash  String
  role          Role
  accountStatus AccountStatus @default(PENDING)

  // Session/security bookkeeping
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin   AdminProfile?
  teacher Teacher?
  student Student?

  sessions   Session[]
  auditLogs  AuditLog[]
  uploadedFiles UploadedFile[]

  @@index([role, accountStatus])
}

// Server-side session record backing refresh tokens, so sessions can be
// revoked (logout, password change, account removal) rather than relying
// purely on JWT expiry.
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  revokedAt    DateTime?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

// --------------------------------------------------------------------------
// ADMIN
// --------------------------------------------------------------------------

// Exactly one row should exist for the fixed super-admin identity created at
// bootstrap ("Zichrisuperadmin100"). Additional admin Users could point to
// their own AdminProfile later if multi-admin support is added, but the
// forced first-login security setup (two verified recovery emails) applies
// per-profile via `securitySetupCompletedAt`.
model AdminProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  recoveryEmail1           String?
  recoveryEmail1Verified   Boolean   @default(false)
  recoveryEmail2           String?
  recoveryEmail2Verified   Boolean   @default(false)

  securitySetupCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Short-lived tokens for verifying recovery emails and for password reset,
// kept out of the AdminProfile row itself so multiple outstanding tokens
// don't collide and each can be looked up/expired independently.
model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  purpose   String   // "RECOVERY_EMAIL_1" | "RECOVERY_EMAIL_2" | "PASSWORD_RESET" | "TEACHER_EMAIL" | "STUDENT_EMAIL"
  token     String   @unique
  target    String   // the email address this token is verifying/resetting against
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, purpose])
}

// --------------------------------------------------------------------------
// TEACHER
// --------------------------------------------------------------------------

model Teacher {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName        String
  email           String  @unique
  profileImageId  String?
  profileImage    UploadedFile? @relation(fields: [profileImageId], references: [id])

  // A teacher's "assigned class" as described in the spec is modeled as a
  // many-to-many through ClassAssignment so a teacher can (now or later)
  // be attached to more than one class without a schema change, while a
  // single "primary" assignment can still be enforced at the API layer.
  classAssignments ClassAssignment[]
  spreadsheets     Spreadsheet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --------------------------------------------------------------------------
// STUDENT
// --------------------------------------------------------------------------

model Student {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email      String  @unique
  // Registration only collects username/email/password (per phase 4 spec) —
  // these profile fields are filled in afterward by the first-login setup
  // wizard, so they must be nullable. A student who hasn't completed the
  // wizard simply has nulls here until they do; nothing else in the schema
  // assumes they're populated.
  firstName  String?
  middleName String?
  lastName   String?
  dateOfBirth DateTime?
  stateOfOrigin String?
  sex        Sex?
  religion   String?

  profileImageId String?
  profileImage   UploadedFile? @relation(fields: [profileImageId], references: [id])

  // Current class only. Historical class membership at the time a given
  // report card was issued is captured on ReportCard itself (snapshot),
  // NOT derived from this field — see IMPORTANT DATABASE RULE below.
  classId String?
  class   Class?  @relation(fields: [classId], references: [id])

  spreadsheetMemberships SpreadsheetStudent[]
  reportCards            ReportCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
}

// --------------------------------------------------------------------------
// CLASSES
// --------------------------------------------------------------------------

// Classes get their own durable id (per "Do not rely only on class names
// as identifiers"). Renaming a class later never breaks historical FKs.
model Class {
  id   String @id @default(cuid())
  name String @unique // e.g. "Basic 6"
  archived Boolean @default(false)

  classAssignments ClassAssignment[]
  students         Student[]
  spreadsheets     Spreadsheet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Join table between Teacher and Class. Modeled explicitly (rather than a
// bare many-to-many) so we can record when/why an assignment was made and
// support one teacher having historical assignments to classes they no
// longer teach.
model ClassAssignment {
  id        String   @id @default(cuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  isPrimary Boolean  @default(true)
  assignedAt DateTime @default(now())
  removedAt  DateTime?

  @@unique([teacherId, classId])
}

// --------------------------------------------------------------------------
// ACADEMIC SESSIONS / TERMS
// --------------------------------------------------------------------------

model AcademicSession {
  id    String @id @default(cuid())
  name  String @unique // e.g. "2026/2027"
  isActive Boolean @default(false)

  terms        Term[]
  spreadsheets Spreadsheet[]

  createdAt DateTime @default(now())
}

model Term {
  id        String @id @default(cuid())
  name      String // "1st Term" | "2nd Term" | "3rd Term"
  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  isActive  Boolean @default(false)

  spreadsheets Spreadsheet[]

  @@unique([sessionId, name])
}

// --------------------------------------------------------------------------
// SUBJECTS
// --------------------------------------------------------------------------

model Subject {
  id   String @id @default(cuid())
  name String @unique
  archived Boolean @default(false)

  scores StudentSubjectScore[]
  spreadsheetSelections SpreadsheetVersionSubject[]

  createdAt DateTime @default(now())
}

// --------------------------------------------------------------------------
// SPREADSHEETS + VERSIONING (the core of the system)
// --------------------------------------------------------------------------

// A "Spreadsheet" is the durable, teacher-facing concept ("Basic 6
// Spreadsheet 2026/2027"). It never itself holds scores. All actual data
// (selected students, scores, remarks, attendance, psychomotor ratings)
// lives on a SpreadsheetVersion. This is what makes locking non-destructive:
// locking freezes a version; further edits create a new DRAFT version
// against the same parent Spreadsheet, and old versions are never mutated
// or deleted.
model Spreadsheet {
  id        String @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  classId   String
  class     Class   @relation(fields: [classId], references: [id])
  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id])
  termId    String
  term      Term @relation(fields: [termId], references: [id])

  // Denormalized pointer to whichever version is currently "live" for
  // editing/display purposes, so callers don't have to compute
  // max(versionNumber) on every read. Still fully reconstructible from
  // SpreadsheetVersion alone if this ever drifts.
  currentVersionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions SpreadsheetVersion[] @relation("SpreadsheetVersions")

  @@unique([teacherId, classId, sessionId, termId])
}

// One immutable-once-locked snapshot of a spreadsheet's contents.
model SpreadsheetVersion {
  id            String @id @default(cuid())
  spreadsheetId String
  spreadsheet   Spreadsheet @relation("SpreadsheetVersions", fields: [spreadsheetId], references: [id], onDelete: Cascade)
  versionNumber Int
  status        SpreadsheetStatus @default(DRAFT)

  lockedAt   DateTime?
  lockedById String? // User.id of whoever locked it (teacher)
  unlockedAt DateTime? // set if a later version supersedes/unlocks this one

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students        SpreadsheetStudent[]
  scores          StudentSubjectScore[]
  psychomotor     PsychomotorRating[]
  attendance      Attendance[]
  teacherRemarks  TeacherRemark[]
  reportCards     ReportCard[]
  selectedSubjects SpreadsheetVersionSubject[]

  @@unique([spreadsheetId, versionNumber])
  @@index([spreadsheetId, status])
}

// Tracks which subjects a spreadsheet version covers, independent of
// whether any scores have been entered yet. This is what lets the editor
// render an empty column for a newly-added subject before a single score
// exists — StudentSubjectScore rows are only created once a value is
// actually typed, but the column itself must still show up.
model SpreadsheetVersionSubject {
  id                   String @id @default(cuid())
  spreadsheetVersionId String
  spreadsheetVersion   SpreadsheetVersion @relation(fields: [spreadsheetVersionId], references: [id], onDelete: Cascade)
  subjectId            String
  subject              Subject @relation(fields: [subjectId], references: [id])
  addedAt              DateTime @default(now())

  @@unique([spreadsheetVersionId, subjectId])
}

// Which students are included in a given spreadsheet version. Kept
// version-scoped (not spreadsheet-scoped) because class rosters change
// between versions and each locked version must reflect exactly who it
// covered at that time.
model SpreadsheetStudent {
  id                   String @id @default(cuid())
  spreadsheetVersionId String
  spreadsheetVersion   SpreadsheetVersion @relation(fields: [spreadsheetVersionId], references: [id], onDelete: Cascade)
  studentId            String
  student              Student @relation(fields: [studentId], references: [id])

  @@unique([spreadsheetVersionId, studentId])
}

model StudentSubjectScore {
  id                   String @id @default(cuid())
  spreadsheetVersionId String
  spreadsheetVersion   SpreadsheetVersion @relation(fields: [spreadsheetVersionId], references: [id], onDelete: Cascade)
  studentId            String
  subjectId            String
  subject              Subject @relation(fields: [subjectId], references: [id])

  caScore    Float?
  examScore  Float?
  totalScore Float?
  grade      String?
  remark     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([spreadsheetVersionId, studentId, subjectId])
}

model PsychomotorRating {
  id                   String @id @default(cuid())
  spreadsheetVersionId String
  spreadsheetVersion   SpreadsheetVersion @relation(fields: [spreadsheetVersionId], references: [id], onDelete: Cascade)
  studentId            String
  trait                String // e.g. "Punctuality", "Neatness", "Honesty"
  rating               Int    // e.g. 1-5

  @@unique([spreadsheetVersionId, studentId, trait])
}

model Attendance {
  id                   String @id @default(cuid())
  spreadsheetVersionId String
  spreadsheetVersion   SpreadsheetVersion @relation(fields: [spreadsheetVersionId], references: [id], onDelete: Cascade)
  studentId            String
  timesPresent         Int @default(0)
  timesAbsent          Int @default(0)
  timesSchoolOpened    Int @default(0)

  @@unique([spreadsheetVersionId, studentId])
}

model TeacherRemark {
  id                   String @id @default(cuid())
  spreadsheetVersionId String
  spreadsheetVersion   SpreadsheetVersion @relation(fields: [spreadsheetVersionId], references: [id], onDelete: Cascade)
  studentId            String
  remark               String

  @@unique([spreadsheetVersionId, studentId])
}

// --------------------------------------------------------------------------
// REPORT CARDS
// --------------------------------------------------------------------------

// A ReportCard is generated FROM a locked SpreadsheetVersion but stores its
// own snapshot fields for the student's identity/class at time of issue.
// This is what satisfies "a student's current profile must not overwrite
// historical academic information" — the report card never joins live to
// Student for display of name/class, only for access-control (who is
// allowed to view it).
model ReportCard {
  id                   String @id @default(cuid())
  studentId            String
  student              Student @relation(fields: [studentId], references: [id])
  spreadsheetVersionId String
  spreadsheetVersion   SpreadsheetVersion @relation(fields: [spreadsheetVersionId], references: [id])

  // Snapshot fields — copied at generation time, never updated afterward.
  snapshotFirstName String
  snapshotLastName  String
  snapshotClassName String
  snapshotSessionName String
  snapshotTermName  String

  issuedAt   DateTime?
  isLocked   Boolean  @default(false) // true once officially issued/immutable
  pdfFileId  String?
  pdfFile    UploadedFile? @relation(fields: [pdfFileId], references: [id])

  deliveryRecords ReportCardDeliveryRecord[]

  createdAt DateTime @default(now())

  @@unique([studentId, spreadsheetVersionId])
}

model ReportCardDeliveryRecord {
  id           String @id @default(cuid())
  reportCardId String
  reportCard   ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  channel      DeliveryChannel
  status       DeliveryStatus @default(PENDING)
  attemptedAt  DateTime @default(now())
  deliveredAt  DateTime?
  failureReason String?
}

// --------------------------------------------------------------------------
// FILE STORAGE
// --------------------------------------------------------------------------

// All uploaded binary assets (profile pictures, school logo, generated
// report card PDFs) are represented as metadata rows pointing at files on
// disk (or an object store, in production) — never as raw bytes in the DB.
model UploadedFile {
  id           String  @id @default(cuid())
  ownerUserId  String?
  ownerUser    User?   @relation(fields: [ownerUserId], references: [id])
  purpose      String  // "PROFILE_IMAGE" | "SCHOOL_LOGO" | "REPORT_CARD_PDF"
  // The actual file bytes, stored directly in the database. Render's
  // (and most free hosts') filesystem is ephemeral — anything written to
  // local disk disappears on every restart/redeploy. Storing bytes here
  // instead means uploaded photos and generated PDFs survive exactly as
  // long as the database does, with no extra paid storage service.
  data         Bytes
  originalName String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  teachers    Teacher[]
  students    Student[]
  reportCards ReportCard[]
}

// --------------------------------------------------------------------------
// AUDIT LOG
// --------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  actorUserId String?
  actorUser   User?  @relation(fields: [actorUserId], references: [id])
  action      String // e.g. "ACCOUNT_CREATED", "SPREADSHEET_LOCKED"
  targetType  String? // e.g. "Student", "Spreadsheet"
  targetId    String?
  metadata    String? // JSON-encoded extra context
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([actorUserId])
  @@index([targetType, targetId])
}

// --------------------------------------------------------------------------
// SCHOOL SETTINGS
// --------------------------------------------------------------------------

// Single-row configuration table (id is always "singleton") so the report
// generator and every other consumer reads config instead of hard-coded
// values.
model SchoolSettings {
  id                String  @id @default("singleton")
  schoolName        String  @default("ZICHRI SCHOOL")
  address           String  @default("5, Ayoola Balogun Street, off Ademoye Street, Ile-Epo Bus Stop, Ikotun-Idumu Road, Lagos.")
  phoneNumbers       String? // JSON-encoded array of strings
  administrativeEmail String?
  logoFileId        String?

  reportCardSettings String? // JSON-encoded: grading scale, remarks bands, etc.

  updatedAt DateTime @updatedAt
}
