# Copy this file to .env and fill in real values before running.

# This project runs on PostgreSQL (e.g. a free Neon or Supabase database).
# Paste your connection string here:
DATABASE_URL="postgresql://user:password@host:5432/zichri_school"

PORT=4000
NODE_ENV=development

# Generate strong random secrets for these, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=changeme_access_secret
JWT_REFRESH_SECRET=changeme_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Fixed bootstrap admin (per spec — username is fixed and cannot change)
BOOTSTRAP_ADMIN_USERNAME=Zichrisuperadmin100
BOOTSTRAP_ADMIN_PASSWORD=123456789

# Email sending (recovery-email verification / password reset / report card
# delivery) — uses Brevo's HTTPS API, not SMTP. This matters specifically on
# hosts like Render's free tier, which block outbound SMTP ports entirely as
# an anti-spam measure — raw SMTP (including Gmail's) cannot work there no
# matter how it's configured. Brevo has a genuinely free tier (300 emails/
# day, no card required): sign up at brevo.com, verify a sender email, then
# create an API key under Settings -> SMTP & API -> API Keys.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="Zichri School"
